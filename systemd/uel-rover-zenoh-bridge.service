[Unit]
Description=UEL Rover - Zenoh bridge (ROS2 DDS <-> Zenoh, wireless uplink)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Environment=ROS_DOMAIN_ID=0
ExecStart=/usr/bin/zenoh-bridge-ros2dds -l tcp/0.0.0.0:7447
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
