[Unit]
Description=UEL Rover - micro-ROS agent (OpenRB-150 USB serial bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
SupplementaryGroups=dialout
Environment=ROS_DOMAIN_ID=0
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
Environment=MICROROS_DISABLE_SHM=1
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source __REPO_DIR__/microros_ws/install/setup.bash && exec ros2 run micro_ros_agent micro_ros_agent serial --dev /dev/ttyACM0 -b 115200'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
