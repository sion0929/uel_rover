<?xml version="1.0"?>
<!--
  화성 월드: rover_landing_px4.sdf 와 같은 PX4 시스템·물리·월드 이름 (PX4 / 브리지 토픽이 그대로 맞는다).
  다른 점은 바닥과 배경뿐이다.
    - martian_surface: 화성 지형 메시 (시각 전용, Kubocarte CC-BY-4.0, models/martian_surface/ATTRIBUTION.md).
      언덕 가까운 평평한 패치 (메시 좌표 (-55, 3)) 를 수평으로 세워 원점에 둠. 원점 반경 5 m 안 높이 -6~0 cm,
      6 m 부터 언덕이 솟는다 (8 m 에서 0.7 m, 15 m 에서 6 m).
    - ground_plane: 충돌 전용 평면 z = 0 (보이지 않음). 로버·드론은 이 평면 위에 선다.
      따라서 언덕은 보이기만 하고 올라가지지 않는다 (반경 약 6 m 안에서 주행할 것).
    - mars_rocks: 저폴리 바위 20개, 시각 + 충돌 (scripts/make_mars_rocks.py).
  중력·대기·자기장은 지구 값 그대로다 (기체·PX4 튜닝이 지구 실기체 기준). 화성 중력이 필요하면 <gravity> 를 바꾼다.
-->
<sdf version="1.9">
  <world name="rover_landing_px4">
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libOpticalFlowSystem.so" name="custom::OpticalFlowSystem"/>

    <scene>
      <ambient>0.62 0.55 0.5 1</ambient>
      <background>0.8 0.66 0.54 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <include>
      <uri>model://martian_surface</uri>
      <pose>52.131356 -2.834992 -31.942602 1.576445 0.097892 0.000277</pose>
    </include>

    <include>
      <uri>model://mars_rocks</uri>
    </include>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
