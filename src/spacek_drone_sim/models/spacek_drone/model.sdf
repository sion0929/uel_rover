<?xml version='1.0' encoding='utf-8'?>
<sdf xmlns:gz="http://gazebosim.org/schema" version="1.9">
  <!--
    spacek_drone: 대회 기체 (Pixhawk 6X + PX4) - PX4 v1.17.0 SITL 용 (3a단계).
    좌표 = 기체 중심, +X 앞, Y 왼쪽, Z 위, 발 바닥 z = -0.1644 m.
    숫자의 원본은 config/drone.yaml (패키지 폴더에서 다시 맞추기:
      python3 -m spacek_drone_sim.drone_sdf config/drone.yaml models/spacek_drone/model.sdf)
    센서·링크 이름은 PX4 x500_base / x500_flow 와 같다 (PX4 gz_bridge 가 이 이름으로 구독).
    모터: PX4 쿼드 X - 0 앞오른쪽 CCW, 1 뒤왼쪽 CCW, 2 앞왼쪽 CW, 3 뒤오른쪽 CW.
    명령 토픽 /spacek_drone/command/motor_speed (PX4 SIM_GZ_EC, 단위 rad/s).
    전방 카메라 = 60° 케이스, 드론 앞 양 다리 사이 가운데 (로버_가제보/drone_gazebo.SLDASM).
  -->
  <model name="spacek_drone">
    <self_collide>false</self_collide>
    <static>false</static>

    <link name="base_link">
      <inertial>
        <pose>0 0 -0.00911 0 0 0</pose>
        <mass>1.833692</mass>
        <inertia><ixx>0.01203</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01203</iyy><iyz>0</iyz><izz>0.01956</izz></inertia>
      </inertial>
      <!-- 충돌: 하부 프레임 상자만 (프롭가드는 비주얼만) -->
      <collision name="lower_frame_col">
        <pose>0 0 -0.0844 0 0 0</pose>
        <geometry><box><size>0.184 0.183 0.16</size></box></geometry>
        <surface><friction><ode><mu>0.3</mu><mu2>0.3</mu2></ode></friction></surface>
      </collision>
      <visual name="drone_mesh_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://spacek_drone/meshes/drone.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.1 0.1 0.15 1</ambient><diffuse>0.25 0.25 0.35 1</diffuse></material>
      </visual>
      <visual name="front_case_visual">
        <pose>0.0679 0.076092 -0.107068 0 -1.57079633 3.14159265</pose>
        <geometry><mesh><uri>model://spacek_drone/meshes/front_cam_case_60.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
      </visual>
      <visual name="down_camera_visual">
        <pose>0 0 -0.12 0 0 0</pose>
        <geometry><box><size>0.03 0.03 0.02</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>

      <!-- PX4 x500_base 와 같은 센서 (잡음값 포함) -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure><noise type="gaussian"><mean>0</mean><stddev>3</stddev></noise></pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.00637</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.00637</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.00686</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>

      <!-- 카메라: 센서 좌표 x = 광축. ROS 영상의 frame_id = 광학 좌표 이름 (TF 는 launch 의 정적 TF) -->
      <sensor name="front_camera" type="camera">
        <gz_frame_id>front_camera_optical</gz_frame_id>
        <pose>0.109589 0 -0.073605 0 1.047198 0</pose>
        <topic>/drone/front_camera/image</topic>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.44368174</horizontal_fov>
          <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>100</far></clip>
        </camera>
      </sensor>
      <sensor name="down_camera" type="camera">
        <gz_frame_id>down_camera_optical</gz_frame_id>
        <pose>0 0 -0.12 0 1.570796 0</pose>
        <topic>/drone/down_camera/image</topic>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.64529933</horizontal_fov>
          <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>100</far></clip>
        </camera>
      </sensor>
    </link>

    <!-- 로터 (x500 과 같은 관성, 비주얼은 7인치 2엽 상자) -->
    <link name="rotor_0">
      <pose>0.1329 -0.1329 0.03 0 0 0</pose>
      <inertial><mass>0.016077</mass><inertia><ixx>3.8465e-07</ixx><ixy>0</ixy><ixz>0</ixz><iyy>2.6116e-05</iyy><iyz>0</iyz><izz>2.6499e-05</izz></inertia></inertial>
      <visual name="rotor_0_blade_0"><pose>0.0445 0 0 0 0 0</pose><geometry><box><size>0.089 0.015 0.002</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><visual name="rotor_0_blade_1"><pose>-0.02225 0.0385381305 0 0 0 2.0943951</pose><geometry><box><size>0.089 0.015 0.002</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><visual name="rotor_0_blade_2"><pose>-0.02225 -0.0385381305 0 0 0 4.1887902</pose><geometry><box><size>0.089 0.015 0.002</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics></axis>
    </joint>
    <link name="rotor_1">
      <pose>-0.1329 0.1329 0.03 0 0 0</pose>
      <inertial><mass>0.016077</mass><inertia><ixx>3.8465e-07</ixx><ixy>0</ixy><ixz>0</ixz><iyy>2.6116e-05</iyy><iyz>0</iyz><izz>2.6499e-05</izz></inertia></inertial>
      <visual name="rotor_1_blade_0"><pose>0.0445 0 0 0 0 0</pose><geometry><box><size>0.089 0.015 0.002</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><visual name="rotor_1_blade_1"><pose>-0.02225 0.0385381305 0 0 0 2.0943951</pose><geometry><box><size>0.089 0.015 0.002</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><visual name="rotor_1_blade_2"><pose>-0.02225 -0.0385381305 0 0 0 4.1887902</pose><geometry><box><size>0.089 0.015 0.002</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics></axis>
    </joint>
    <link name="rotor_2">
      <pose>0.1329 0.1329 0.03 0 0 0</pose>
      <inertial><mass>0.016077</mass><inertia><ixx>3.8465e-07</ixx><ixy>0</ixy><ixz>0</ixz><iyy>2.6116e-05</iyy><iyz>0</iyz><izz>2.6499e-05</izz></inertia></inertial>
      <visual name="rotor_2_blade_0"><pose>0.0445 0 0 0 0 0</pose><geometry><box><size>0.089 0.015 0.002</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><visual name="rotor_2_blade_1"><pose>-0.02225 0.0385381305 0 0 0 2.0943951</pose><geometry><box><size>0.089 0.015 0.002</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><visual name="rotor_2_blade_2"><pose>-0.02225 -0.0385381305 0 0 0 4.1887902</pose><geometry><box><size>0.089 0.015 0.002</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics></axis>
    </joint>
    <link name="rotor_3">
      <pose>-0.1329 -0.1329 0.03 0 0 0</pose>
      <inertial><mass>0.016077</mass><inertia><ixx>3.8465e-07</ixx><ixy>0</ixy><ixz>0</ixz><iyy>2.6116e-05</iyy><iyz>0</iyz><izz>2.6499e-05</izz></inertia></inertial>
      <visual name="rotor_3_blade_0"><pose>0.0445 0 0 0 0 0</pose><geometry><box><size>0.089 0.015 0.002</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><visual name="rotor_3_blade_1"><pose>-0.02225 0.0385381305 0 0 0 2.0943951</pose><geometry><box><size>0.089 0.015 0.002</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual><visual name="rotor_3_blade_2"><pose>-0.02225 -0.0385381305 0 0 0 4.1887902</pose><geometry><box><size>0.089 0.015 0.002</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics></axis>
    </joint>

    <!-- H-Flow 광류: PX4 optical_flow 모델과 같은 센서 (flow_camera 영상 -> OpticalFlowSystem) -->
    <link name="flow_link">
      <pose>-0.0558 0 -0.105 0 0 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>1e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-05</iyy><iyz>0</iyz><izz>1e-05</izz></inertia></inertial>
      <visual name="hflow_visual">
        <geometry><box><size>0.034 0.034 0.01</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="flow_camera" type="camera">
        <gz_frame_id>flow_link</gz_frame_id>
        <pose>0 0 0 0 1.5707 0</pose>
        <camera>
          <horizontal_fov>0.733038</horizontal_fov>
          <image><width>100</width><height>100</height></image>
          <clip><near>0.1</near><far>30</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <visualize>false</visualize>
      </sensor>
      <sensor name="optical_flow" type="custom" gz:type="optical_flow">
        <gz_frame_id>flow_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="flow_joint" type="fixed">
      <parent>base_link</parent>
      <child>flow_link</child>
    </joint>

    <!-- H-Flow ToF 거리: PX4 x500_flow 와 같은 링크·센서 자세 (PX4 가 아래 방향으로 인식) -->
    <link name="lidar_sensor_link">
      <pose>-0.0558 0.008 -0.105 0 1.57 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>1e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-05</iyy><iyz>0</iyz><izz>1e-05</izz></inertia></inertial>
      <sensor name="lidar" type="gpu_lidar">
        <gz_frame_id>lidar_sensor_link</gz_frame_id>
        <pose>0 0 0 3.14 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.08</min><max>30</max><resolution>0.01</resolution></range>
        </ray>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="lidar_sensor_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
    </joint>

    <!-- 모터 (x500 과 같은 플러그인, 순서 = PX4 모터 번호) -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1650.61259</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1650.61259</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1650.61259</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1650.61259</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </model>
</sdf>